{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SentimentAnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sentiment_label",
    "score",
    "confidence",
    "summary",
    "recommended_actions",
    "top_signals",
    "topics",
    "metrics"
  ],
  "properties": {
    "sentiment_label": {
      "type": "string",
      "enum": ["positive", "neutral", "mixed", "negative"]
    },
    "score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "top_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
